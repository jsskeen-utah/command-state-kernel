{
  "name": "expense-sample",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Expense approval sample on the command-state kernel: REST API, MCP server, and Angular screen",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "cli": "node src/cli.ts",
    "test": "node --test test/expense.test.ts test/mcp.test.ts test/permissions.test.ts test/cli.test.ts && vitest run",
    "test:node": "node --test test/expense.test.ts test/mcp.test.ts test/permissions.test.ts test/cli.test.ts",
    "test:ui": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
